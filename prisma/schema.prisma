generator client {
  provider = "prisma-client"
  output   = "../src/lib/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

model User {
  id                 String    @id @default(uuid())
  username           String    @unique
  displayName        String
  passwordHash       String
  avatarUrl          String?
  roleTitle          String    @default("Operative")
  status             String    @default("Online")
  activeAgentSlug    String?
  mustChangePassword Boolean   @default(true)
  passwordChangedAt  DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  posts              Post[]
  comments           Comment[]
  reactions          Reaction[]
}

model Room {
  id          String   @id @default(uuid())
  name        String   @unique
  slug        String   @unique
  description String?
  icon        String   @default("radio")
  color       String   @default("#ef4444")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  posts       Post[]
}

model Post {
  id           String   @id @default(uuid())
  authorId     String
  roomId       String
  type         String   @default("human_broadcast")
  title        String?
  body         String
  mediaUrl     String?
  mediaType    String?
  linkUrl      String?
  metadataJson String?
  priority     String   @default("normal")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  author       User      @relation(fields: [authorId], references: [id])
  room         Room      @relation(fields: [roomId], references: [id])
  comments     Comment[]
  reactions    Reaction[]
}

model Comment {
  id        String   @id @default(uuid())
  postId    String
  authorId  String
  body      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  author    User     @relation(fields: [authorId], references: [id])
}

model Reaction {
  id        String   @id @default(uuid())
  postId    String
  userId    String
  emoji     String
  label     String
  createdAt DateTime @default(now())

  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id])

  @@unique([postId, userId, emoji])
}

model Agent {
  id                      String   @id @default(uuid())
  name                    String   @unique
  slug                    String   @unique
  roleTitle               String
  avatarUrl               String?
  status                  String   @default("Idle")
  apiTokenHash            String?

  stylizedName            String?
  rankTitle               String   @default("Recruit")
  level                   Int      @default(0)
  xpTotal                 BigInt   @default(0)
  identitySeed            String?
  bio                     String?
  motto                   String?
  favoriteGenresJson      String?
  imageStylePreset        String?
  imageProviderPreference String   @default("local-first")
  topSongTrackId          String?
  topSongAutoplay         Boolean  @default(true)

  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt

  tracks                  AgentTrack[]
  playbackEvents          AgentPlaybackEvent[]
  topSong                 AgentTrack? @relation("AgentTopSong", fields: [topSongTrackId], references: [id], onDelete: SetNull)
}

model AgentTrack {
  id                String   @id @default(uuid())
  agentId           String
  title             String
  artist            String?
  genre             String?
  sourceUrl         String?
  durationMs        Int?
  playCount         Int      @default(0)
  skipCount         Int      @default(0)
  muteCount         Int      @default(0)
  volumeAdjustCount Int      @default(0)
  totalListenMs     BigInt   @default(0)
  lastPlayedAt      DateTime?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  agent             Agent    @relation(fields: [agentId], references: [id], onDelete: Cascade)
  events            AgentPlaybackEvent[]
  topSongFor        Agent[]  @relation("AgentTopSong")

  @@index([agentId])
  @@index([playCount])
}

model AgentPlaybackEvent {
  id          String   @id @default(uuid())
  agentId     String
  trackId     String?
  eventType   String
  sessionId   String?
  eventAt     DateTime @default(now())
  positionMs  Int?
  listenedMs  Int?
  volume      Int?
  muted       Boolean?
  source      String?
  contextJson String?

  agent       Agent    @relation(fields: [agentId], references: [id], onDelete: Cascade)
  track       AgentTrack? @relation(fields: [trackId], references: [id], onDelete: SetNull)

  @@index([agentId, eventAt])
  @@index([trackId, eventAt])
  @@index([eventType, eventAt])
}

model ImageProviderSetting {
  id             String   @id @default(uuid())
  provider       String   @unique
  enabled        Boolean  @default(false)
  priority       Int      @default(100)
  baseUrl        String?
  modelName      String?
  apiKeyMasked   String?
  apiKeyCipher   String?
  localModelPath String?
  settingsJson   String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

# THE WAR ROOM — Environment Variables
# Copy this file to .env and fill in real values.
# NEVER commit .env to Git.

# SQLite database file path
DATABASE_URL="file:./dev.db"

# JWT signing secret — generate with: openssl rand -base64 48
NEXTAUTH_SECRET="CHANGE_ME_TO_A_LONG_RANDOM_SECRET_MIN_32_CHARS"

# Node environment
NODE_ENV="production"

# App server bind settings (localhost only for Tailnet deployment)
PORT=3000
HOSTNAME="127.0.0.1"
